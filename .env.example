# GitHub Personal Access Token (PAT)
# Optional but recommended (increases Search API limit to 30 req/min, Core to 5000 req/hour)
GITHUB_TOKEN=

# Hugging Face Access Token
# Optional (needed for gated models and higher rate limits)
HF_TOKEN=

# Cache Directory (Optional: defaults to OS-standard app data cache via platformdirs)
# STACK_SCOUT_CACHE_DIR=

# Custom Weights Override (Optional: JSON string)
# STACK_SCOUT_WEIGHTS=
